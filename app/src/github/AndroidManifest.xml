<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <permission
        android:name="${applicationId}.permission.COLOROS_COURSE_BRIDGE"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.COLOROS_COURSE_BRIDGE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.suda.yzune.wakeupschedule" />
        <provider android:authorities="com.suda.yzune.wakeupschedule.provider" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.xiaomi.xmsf" />
    </queries>

    <application>
        <service
            android:name=".feature.todo.TodoQuickCaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_todo_capture"
            android:label="提取待办"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <receiver
            android:name=".feature.experimental.XiaomiNetworkRestoreReceiver"
            android:exported="false" />
        <provider
            android:name=".feature.coloros.ColorOSCourseExportProvider"
            android:authorities="${applicationId}.coloros.course"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="${applicationId}.permission.COLOROS_COURSE_BRIDGE" />
    </application>
</manifest>
